                      class="contact-form reveal"
                      novalidate>

                    <div class="form-group">

                        <label for="name">
                            Name
                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               placeholder="Enter your name">

                        <small class="error-message"
                               id="name-error"></small>

                    </div>


                    <div class="form-group">

                        <label for="email">
                            Email
                        </label>

                        <input type="email"
                               id="email"
                               name="email"
                               placeholder="Enter your email">

                        <small class="error-message"
                               id="email-error"></small>

                    </div>


                    <div class="form-group">

                        <label for="message">
                            Message
                        </label>

                        <textarea id="message"
                                  name="message"
                                  rows="5"
                                  placeholder="Enter your message"></textarea>

                        <small class="error-message"
                               id="message-error"></small>

                    </div>


                    <button type="submit"
                            class="btn primary-btn submit-btn">

                        Send Message

                    </button>


